,{"stream_name":"stderr","time":104.800595132,"data":"     44 (CODE/'gpu_smoke_harness.py').write_text('\"\"\"Bounded diagnostic wrapper ONLY. Imports the exact reviewed implementation unchanged.\"\"\"\\nimport argparse,json,time,hashlib,subprocess,shutil\\nfrom pathlib import Path\\nfrom dataclasses import asdict\\nimport numpy as np\\nimport pandas as pd\\nimport torch\\nfrom biomass_jepa import train as common\\nfrom biomass_jepa.dino_finetune import (FinetuneConfig,audit_source,configure_backbone,configure_precision,forward_dense,load_d2_head,fit_arm,read_views,masked_bias_contract,write)\\nfrom biomass_jepa.dinov3_dense import load_dinov3\\nfrom biomass_jepa.data import file_sha256,TARGETS\\nfrom biomass_jepa.predictor_specialize import state_digest\\nfrom biomass_jepa.final_metrics import global_r2\\n\\np=argparse.ArgumentParser()\\nfor n in [\\'source\\',\\'images\\',\\'repository\\',\\'checkpoint\\',\\'metadata\\',\\'lock\\',\\'output\\',\\'package-sha\\']:p.add_argument(\\'--\\'+n,required=True)\\na=p.parse_args();O=Path(a.output);O.mkdir(parents=True,exist_ok=True);started=time.monotonic();device=torch.device(\\'cuda\\');torch.set_num_threads(2)\\nconfig=FinetuneConfig(epochs=2,batch_size=2,accumulate=8)\\nproof={\\'status\\':\\'RUNNING_SMOKE_ONLY\\',\\'package_sha256\\':a.package_sha,\\'full_training_launched\\':False,\\'F3_enabled\\':False,\\'max_optimizer_updates\\':10,\\'smoke_config\\':asdict(config),\\'full_config_not_executed\\':asdict(FinetuneConfig()),\\'checks\\':{},\\'arms\\':{},\\'timings\\':{}}\\nwrite(O/\\'STATUS.json\\',proof)\\n\\ndef emit(name,row):\\n print(name+\\' \\'+json.dumps(row,allow_nan=False),flush=True);write(O/(name+\\'.json\\'),row)\\n\\ndef fresh(fold):\\n m,origin=load_dinov3(a.repository,a.checkpoint,metadata,device)\\n rel=f\\'dinov3/fold_{fold}/D2/head_selected.pt\\';h,ck=load_d2_head(Path(a.source)/rel,lock[\\'inputs\\'][rel],fold,device)\\n return m,h,origin\\n\\ntry:\\n name=torch.cuda.get_device_name();cap=torch.cuda.get_device_capability()\\n if \\'rtx pro 6000\\' not in name.lower() or cap[0]\u003c10:raise RuntimeError(\\'Actual RTXPRO6000Blackwell required.\\')\\n print(\\'ACTUAL GPU: \\'+name,flush=True)\\n gpu={\\'name\\':name,\\'capability\\':list(cap),\\'torch\\':str(torch.__version__),\\'cuda\\':torch.version.cuda,\\'total_memory_bytes\\':torch.cuda.get_device_properties(device).total_memory,\\'nvidia_smi\\':subprocess.check_output([\\'nvidia-smi\\',\\'--query-gpu=name,memory.total,driver_version\\',\\'--format=csv,noheader\\'],text=True).strip()}\\n proof[\\'gpu\\']=gpu;emit(\\'HARDWARE\\',gpu)\\n lock=json.loads(Path(a.lock).read_text());metadata=json.loads(Path(a.metadata).read_text());frame=audit_source(a.source,a.images,lock)\\n if file_sha256(a.checkpoint)!=metadata[\\'checkpoint_sha256\\']:raise ValueError(\\'Checkpoint hash differs.\\')\\n # Cached features only a READ-ONLY parity oracle; fit_arm below reads pixels.\\n prior=Path(a.source);cache=torch.load(prior/\\'dinov3/features.pt\\',weights_only=True,map_location=\\'cpu\\');features=cache[\\'features\\'][0]\\n cache_manifest=json.loads((prior/\\'dinov3/cache_manifest.json\\').read_text())\\n if file_sha256(prior/\\'dinov3/features.pt\\')!=cache_manifest[\\'features_sha256\\']:raise ValueError(\\'Parity cache bytes differ from pinned manifest.\\')\\n emit(\\'INPUTS\\',{\\'source\\':lock[\\'source\\'],\\'DINO_sha256\\':file_sha256(a.checkpoint),\\'D2_heads\\':{str(f):lock[\\'inputs\\'][f\\'dinov3/fold_{f}/D2/head_selected.pt\\'] for f in [0,1]},\\'photos\\':len(frame),\\'cache_used_for_training\\':False})\\n parity=[];initial_hashes={}\\n for fold in [0,1]:\\n  m,h,origin=fresh(fold);configure_backbone(m,\\'F1\\');precision=configure_precision(m,h,device)\\n  indices=np.flatnonzero(frame.fold.to_numpy()==fold);cached=features[indices].to(device)\\n  with torch.no_grad(),common.amp(device):pred_cached=h(cached).float().cpu().numpy()\\n  saved=pd.read_csv(prior/f\\'dinov3/fold_{fold}/D2/val_predictions.csv\\').set_index(\\'image_path\\').loc[frame.iloc[indices].image_path]\\n  old=saved[[\\'pred_\\'+t for t in TARGETS]].to_numpy(np.float64);cached_diff=float(np.abs(old-pred_cached).max())\\n  # Encode two heldout originals with original cache\\'s paired neighbor and shape.\\n  chosen=indices[:2];recomputed=cached.clone();feature_differences=[]\\n  for idx in chosen:\\n   begin=int(idx)//2*2;rows=frame.iloc[begin:begin+2]\\n   with torch.no_grad(),common.amp(device):actual=forward_dense(m,read_views(rows).to(device)).float()\\n   pos=int(np.flatnonzero(indices==idx)[0]);original=features[idx].to(device)\\n   feature_differences.append(float((actual[int(idx)-begin]-original).abs().max()));recomputed[pos]=actual[int(idx)-begin]\\n  with torch.no_grad(),common.amp(device):pred_new=h(recomputed).float().cpu().numpy()\\n  encoded_diff=float(np.abs(pred_new-old).max())\\n  y=saved[TARGETS].to_numpy(np.float64);r2old=global_r2(y,old);r2cached=global_r2(y,pred_cached)\\n  row={\\'fold\\':fold,\\'cached_head_max_abs_prediction_difference_g\\':cached_diff,\\'reencoded_start_max_abs_prediction_difference_g\\':encoded_diff,\\'patch_grid_max_abs_difference\\':max(feature_differences),\\'same_original_encoding_batch_pairs\\':True,\\'heldout_reencoded_images\\':frame.iloc[chosen].image_path.tolist(),\\'cached_head_all_validation_images\\':len(indices),\\'saved_D2_fold_R2\\':r2old,\\'replayed_D2_fold_R2\\':r2cached,\\'R2_absolute_difference\\':abs(r2old-r2cached),\\'predeclared_cached_head_tolerance_g\\':.01,\\'predeclared_reencoded_tolerance_g\\':1.,\\'passes\\':cached_diff\u003c=.01 and encoded_diff\u003c=1.,\\'precision\\':precision}\\n  parity.append(row);emit(\\'PARITY_FOLD\\'+str(fold),row)\\n  if not row[\\'passes\\']:raise ValueError(\\'D2 starting-prediction parity failed predefined bounds.\\')\\n  # Initial F2 features must preserve F1 outputs despite enabling gradients.\\n  probe=read_views(frame.iloc[np.flatnonzero(frame.fold.to_numpy()!=fold)[:2]]).to(device)\\n  with torch.no_